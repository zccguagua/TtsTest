<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 背景：侧滑后露出的删除按钮（点它才真正删除） -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFF44336"
        android:gravity="center"
        android:text="@string/phrases_delete"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <!-- 前景：内容，侧滑时移开露出删除按钮 -->
    <LinearLayout
        android:id="@+id/itemForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivSpeak"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/phrases_speak_desc"
            android:src="@drawable/ic_volume"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvPhrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textSize="18sp" />

    </LinearLayout>
</FrameLayout>
